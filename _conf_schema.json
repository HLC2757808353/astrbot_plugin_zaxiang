        "hint": "被戳时反戳回去的概率，0~1，默认0.5"
      },
      "follow_probability": {
        "description": "跟戳概率",
        "type": "float",
        "default": 0.3,
        "hint": "别人互戳时AI跟戳同一人的概率，0~1，默认0.3"
      }
    }

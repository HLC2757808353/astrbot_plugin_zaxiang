      "enabled": {
        "description": "是否启用冷暴力功能",
        "type": "bool",
        "default": true,
        "hint": "启用后AI可以冷暴力骚扰者"
      },
      "authority_ids": {
        "description": "权限ID列表",
        "type": "list",
        "default": [],
        "hint": "在此列表中的用户可以执行冷暴力和解除冷暴力指令"
      },
      "whitelist_ids": {
        "description": "白名单ID列表",
        "type": "list",
        "default": [],
        "hint": "在此列表中的用户不能被冷暴力"
      },
      "default_duration": {
        "description": "默认冷暴力时长（分钟）",
        "type": "int",
        "default": 30,
        "hint": "默认的冷暴力持续时间"
      }
    }
  },
  "mute_tracker": {
    "description": "禁言追踪配置",
    "type": "object",
    "hint": "追踪AI被禁言的情况，解禁后告知被谁禁言的",
    "items": {
      "enabled": {
        "description": "是否启用禁言追踪",
        "type": "bool",
        "default": true,
        "hint": "启用后AI被禁言解禁时会告知是谁禁言的"
      }
    }
  },
  "poke_reaction": {
    "description": "戳一戳反应配置",
    "type": "object",
